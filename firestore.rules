rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isApproved() { return signedIn() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved'; }
    // স্থায়ী অ্যাডমিন নম্বর: 01731141115, 01780972945 (ফোন থেকে বানানো লুকানো আইডি)
    function isAdminPhone() {
      return signedIn() && request.auth.token.email in ['p1731141115@noorfashion.example', 'p1780972945@noorfashion.example'];
    }
    // The very first registered account claims the admin role (bootstrap doc + admin doc + member doc in one batch)
    function firstAdminClaim(uid) {
      return !exists(/databases/$(database)/documents/config/bootstrap)
          && getAfter(/databases/$(database)/documents/config/bootstrap).data.uid == uid;
    }

    match /config/bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/config/bootstrap)
                    && request.resource.data.uid == request.auth.uid;
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && ((request.auth.uid == uid && (firstAdminClaim(uid) || isAdminPhone())) || isAdmin());
      // অ্যাডমিন অন্য কাউকে অ্যাডমিন থেকে সরাতে পারে (নিজেকে নয়)
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Phone -> email index so people can sign in with their phone number.
    // Single-doc lookup is public (needed before sign-in); listing is not allowed.
    match /phoneLogins/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // One profile per account: pending until an admin approves it
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && (request.resource.data.status == 'pending'
                        || (request.resource.data.status == 'approved' && (firstAdminClaim(uid) || isAdminPhone())));
      allow update: if (signedIn() && request.auth.uid == uid && isAdminPhone())
                    || (isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'role']))
                    || (signedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'title', 'org', 'orgType', 'mgmt', 'branch', 'phone', 'address', 'email']));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // অ্যাকাউন্ট সংখ্যা (শুধু গণনা): অ্যাডমিনের অ্যাপ লেখে, সবাই পড়তে পারে
    match /stats/accounts {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shared organisation data: only approved members
    match /org/main {
      allow read, write: if isApproved();
    }
  }
}
